{
  "name": "car-dealership-bff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS BFF - lop trung gian giua frontend va core API",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "prepare": "husky",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "generate:types": "openapi-typescript openapi/core-api.openapi.json -o src/core-api/generated/schema.d.ts",
    "sync-openapi": "node scripts/sync-openapi.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.1.0",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "jose": "6.1.0",
    "nestjs-pino": "5.3.1",
    "openapi-fetch": "0.17.0",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.14.0",
    "fast-check": "4.10.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "openapi-typescript": "7.10.1",
    "pino-pretty": "13.2.0",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
