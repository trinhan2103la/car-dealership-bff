# Khóa riêng ES256 của Service_Credential (BFF → Core_API). PKCS8 PEM; xuống dòng thay bằng \n, hoặc base64 một dòng.
# Sinh bằng: node scripts/gen-es256.mjs  — KHÔNG commit khóa thật.
# Khóa công khai tương ứng đồng bộ THỦ CÔNG sang SERVICE_JWT_PUBLIC_KEY của car-dealership-core.
SERVICE_JWT_PRIVATE_KEY=

# --- Core_API client ---
# URL gốc của Core_API (host khó đoán, chỉ nằm ở env BFF; không bao giờ xuất hiện trong lỗi trả ra ngoài).
CORE_API_URL=
# Secret 32 byte ngẫu nhiên, trùng EDGE_KEY của car-dealership-core. Mỗi secret một giá trị riêng.
EDGE_KEY=
# Timeout gọi Core_API (ms), mặc định 10000.
CORE_API_TIMEOUT_MS=

# --- Access token + refresh token ---
# Khóa riêng ES256 để BFF ký/kiểm access token (10 phút) của Admin_Portal. PHẢI KHÁC SERVICE_JWT_PRIVATE_KEY.
# Sinh bằng: node scripts/gen-es256.mjs admin  — chỉ nằm ở BFF, KHÔNG đồng bộ sang Core_API.
ADMIN_JWT_PRIVATE_KEY=
# Origin được phép gọi /refresh và /logout (dựa vào cookie), phân tách dấu phẩy. Production BẮT BUỘC, thiếu = chặn hết.
# Dev để trống = http://localhost:5173 (Admin_Portal) và http://localhost:3000 (Swagger UI).
ALLOWED_ORIGINS=
# Chỉ dev HTTP thuần: true => cookie refresh tên 'cdp_rt' không Secure. Bị bỏ qua khi NODE_ENV=production.
AUTH_INSECURE_DEV_COOKIE=
# Đăng nhập tối đa N lần / cửa sổ (mặc định 10 lần / 60000 ms / IP).
AUTH_LOGIN_RATE_LIMIT=
AUTH_LOGIN_RATE_WINDOW_MS=
# Refresh tối đa N lần / 60 s / IP (mặc định 30).
AUTH_REFRESH_RATE_LIMIT=
# Số proxy tin cậy phía trước BFF (Render = 1). 0/trống = bỏ qua X-Forwarded-For (chống giả mạo IP).
TRUST_PROXY_HOPS=
